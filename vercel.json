{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "frontend",
        "path": "/favicon.svg"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
