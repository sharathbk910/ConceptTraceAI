# Application
VITE_APP_NAME=ConceptTrace AI
VITE_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Supabase public configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upload configuration
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=5
PRIVATE_STORAGE_BUCKET=student-learning-files

# Learning analytics
STUDY_IDLE_TIMEOUT_SECONDS=120
MIN_ACTIVE_DAY_SECONDS=300
WEAK_TOPIC_MIN_ATTEMPTS=5

# API security
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=60
ALLOWED_ORIGINS=http://localhost:5173

# Reporting
PDF_REPORT_MAX_DAYS=365
DEFAULT_TIMEZONE=Asia/Kolkata

# Backend configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info
