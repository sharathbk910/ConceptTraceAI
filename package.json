{
  "name": "concepttrace-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ConceptTrace AI - Learn • Improve • Succeed",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@supabase/supabase-js": "^2.43.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "mathjs": "^12.4.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
